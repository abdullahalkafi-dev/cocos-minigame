              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/players/{{playerId}}/debit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "players",
            "{{playerId}}",
            "debit"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 1000,\n  \"reference\": \"order-1001\",\n  \"note\": \"string\",\n  \"displayName\": \"string\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "A player's coin history, newest first, including bets and wins made by the game",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/players/{{playerId}}/transactions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "players",
            "{{playerId}}",
            "transactions"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50",
              "disabled": true
            },
            {
              "key": "before",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "The finished rounds of a player, newest first: room, round, result, stake and win per option",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
