        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/players/{{playerId}}/rounds",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "players",
            "{{playerId}}",
            "rounds"
          ],
          "query": [
            {
              "key": "limit",
              "value": "50",
              "disabled": true
            },
            {
              "key": "before",
              "value": "",
              "disabled": true
            },
            {
              "key": "room",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "Rooms of a game with the players online in each (oldest first, paged)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/rooms",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "rooms"
          ],
          "query": [
            {
              "key": "limit",
              "value": "100",
              "disabled": true
            },
            {
              "key": "offset",
              "value": "0",
              "disabled": true
            }
          ]
        }
      }
    },
