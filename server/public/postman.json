        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"string\",\n  \"name\": \"string\",\n  \"capacity\": 1000,\n  \"auto\": true,\n  \"metadata\": {},\n  \"deleteWhenEmptyMinutes\": 1000,\n  \"overrides\": {\n    \"title\": \"string\",\n    \"chips\": [\n      1000\n    ],\n    \"maxPerTarget\": 1000,\n    \"timing\": {\n      \"betSeconds\": 1000,\n      \"spinSeconds\": 1000,\n      \"resultSeconds\": 1000\n    }\n  }\n}",
