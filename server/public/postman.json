{
  "info": {
    "name": "MiniGame Studio client API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Generated from /openapi.json. Set the variables: baseUrl, apiKey, gameId, playerId."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "{{HOST}}"
    },
    {
      "key": "apiKey",
      "value": "mgs_..."
    },
    {
      "key": "gameId",
      "value": "lic_..."
    },
    {
      "key": "playerId",
      "value": "user-8841"
    }
  ],
  "item": [
    {
      "name": "Create a 15-minute play link for one player",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/sessions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "sessions"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"gameId\": \"{{gameId}}\",\n  \"playerId\": \"{{playerId}}\",\n  \"displayName\": \"string\",\n  \"avatarUrl\": \"string\",\n  \"room\": \"string\",\n  \"startingBalance\": 1000\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "The games this key can open",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games"
          ],
          "query": []
        }
      }
    },
    {
      "name": "A player's balance",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/players/{{playerId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "players",
            "{{playerId}}"
          ],
          "query": []
        }
      }
    },
    {
      "name": "Add coins (managed wallet)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{apiKey}}",
              "type": "string"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/games/{{gameId}}/players/{{playerId}}/credit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "games",
            "{{gameId}}",
            "players",
            "{{playerId}}",
            "credit"
          ],
          "query": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 1000,\n  \"reference\": \"order-1001\",\n  \"note\": \"string\",\n  \"displayName\": \"string\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Remove coins, e.g. a cash-out (managed wallet)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
