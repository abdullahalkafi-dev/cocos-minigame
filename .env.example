# Public address of this deployment (used inside the play links handed to clients)
PUBLIC_URL=http://localhost:3000
PORT=3000
# Where the database, secret key and uploaded images live (mount this as a volume)
DATA_DIR=./server/data
# Optional: fixed secret for signing tokens (otherwise generated once into DATA_DIR/secret.key)
# SESSION_SECRET=change-me-to-a-long-random-string

# docker compose only: host port to publish on 127.0.0.1
HOST_PORT=3000
