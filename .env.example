# Public address of this deployment (used inside the play links handed to clients)
PUBLIC_URL=http://localhost:3000
PORT=3000

# MongoDB (Atlas or any replica set: money movements use transactions). Use a different database name per environment.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/minigame_dev?retryWrites=true&w=majority

# Redis: cache, shared rate limits, locks. Optional locally (falls back to memory); docker compose provides it.
REDIS_URL=redis://127.0.0.1:6379

# Where the secret key and uploaded images live (mount this as a volume)
DATA_DIR=./server/data
# Optional: fixed secret for signing tokens (otherwise generated once into DATA_DIR/secret.key)
# SESSION_SECRET=change-me-to-a-long-random-string

# docker compose only: host port to publish on 127.0.0.1
HOST_PORT=3000
